# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Centralized site URL for custom domain (e.g., https://davidkayikinkela.com)
NEXT_PUBLIC_SITE_URL="https://davidkayikinkela.com"

# Resend API Key for sending emails from the contact form (optional in local dev)
RESEND_API_KEY=""

# Recipient email where contact form submissions are delivered
CONTACT_RECIPIENT_EMAIL="contact@davidkayikinkela.com"
